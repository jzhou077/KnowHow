{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["uv add"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["...", "./my-custom-build.sh"]
    }
  },
  "deploy": {
    "startCommand": "streamlit run UserInterface.py"
  }
}